{
  "bsonType": "object",
  "required": ["company_name", "user_id"],
  "permission": {
    "read": true,
    "create": true,
    "update": true,
    "delete": true
  },
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "存储文档 ID，系统自动生成"
    },
    "company_name": {
      "bsonType": "string",
      "description": "公司名称",
      "label": "公司名称",
      "trim": "both"
    },
    "website": {
      "bsonType": "string",
      "description": "公司网址",
      "label": "公司网址",
      "trim": "both"
    },
    "position": {
      "bsonType": "string",
      "description": "岗位名称",
      "label": "岗位",
      "trim": "both"
    },
    "status": {
      "bsonType": "string",
      "description": "投递状态",
      "label": "进度",
      "enum": ["已投递", "面试中", "已通过", "已拒绝"],
      "defaultValue": "已投递"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户ID",
      "label": "用户ID",
      "trim": "both"
    },
    "create_time": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "label": "创建时间",
      "defaultValue": {
        "$env": "now"
      }
    },
    "update_time": {
      "bsonType": "timestamp",
      "description": "更新时间",
      "label": "更新时间",
      "defaultValue": {
        "$env": "now"
      }
    },
    "remark": {
      "bsonType": "string",
      "description": "备注",
      "label": "备注",
      "trim": "both"
    }
  }
}